# =============================================================================
# Mẫu .env cho CHẠY THẬT trên VPS.
#
# Cách dùng:  cp deploy/.env.production.example .env  →  sửa 4 chỗ có dấu ◀
#             chmod 600 .env
#
# Tệp .env đã nằm trong .gitignore — KHÔNG commit lên git.
# =============================================================================

NODE_ENV=production
PORT=3000

# ◀ 1. Tên miền thật, không có dấu / ở cuối
SITE_URL=https://kythuatdoluongtaynambo.com.vn

# ◀ 2. Đường dẫn CMS — đổi thành chuỗi khó đoán.
#    Bot dò /cms, /admin cả ngày. Đổi đi thì chúng không tìm được cửa nào để dò.
#    Đổi rồi phải nhớ: địa chỉ vào CMS là https://kythuatdoluongtaynambo.com.vn/quan-tri-x7k2
CMS_PATH=/quan-tri-x7k2

# ◀ 3. Chạy sau Nginx thì BẮT BUỘC đặt 1.
#    Để trống: mọi khách đều mang IP 127.0.0.1 → giới hạn "sai mật khẩu 6 lần"
#    tính chung cho tất cả, một người sai là cả nhà bị khóa.
#    Ngược lại, đặt 1 khi KHÔNG có Nginx thì kẻ tấn công giả mạo được IP.
TRUST_PROXY=1

# ◀ 4. Mật khẩu CMS lần chạy đầu tiên.
#    Chỉ dùng khi server/data/credentials.json chưa tồn tại. Sau khi tạo xong,
#    server tự băm mật khẩu, xóa bản rõ, và biến này thành vô tác dụng.
#    → Đăng nhập lần đầu xong thì XÓA dòng này đi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Khóa ký phiên đăng nhập.
# Để trống là ổn với 1 tiến trình: server tự sinh và lưu vào server/data/.jwt-secret
# Chỉ cần đặt tay khi chạy PM2 cluster / nhiều máy chủ.
#   Sinh khóa:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Phiên đăng nhập
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d
REMEMBER_DAYS=30

# Chống dò mật khẩu
MAX_LOGIN_ATTEMPTS=6
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Giới hạn dung lượng mỗi tệp tải lên (MB).
# Phải NHỎ HƠN client_max_body_size trong nginx.conf, nếu không Nginx chặn
# trước và khách chỉ thấy lỗi 413 khô khan thay vì thông báo tiếng Việt.
UPLOAD_MAX_MB=15

# Để trống là đủ: server tự tin tưởng chính host của nó.
# Chỉ điền khi CMS và website nằm ở hai tên miền khác nhau.
TRUSTED_ORIGINS=

# Thư mục dữ liệu. Để trống = server/data (nằm trong project).
# Đặt ra ngoài project nếu muốn `git pull` không bao giờ chạm tới dữ liệu:
#   DATA_DIR=/var/lib/candien
DATA_DIR=
