# Sao chép tệp này thành .env trước khi chạy production.
# KHÔNG commit tệp .env lên git (đã có trong .gitignore).

PORT=3000
NODE_ENV=development

# Tên miền thật của website, ví dụ https://candientutaynambo.com
# Dùng cho sitemap.xml, thẻ canonical, và dòng log khi khởi động.
# Ô "Địa chỉ website" trong CMS ưu tiên cao hơn biến này (đổi được không cần SSH).
# LƯU Ý: KHÔNG có dấu / ở cuối.
SITE_URL=

# Đường dẫn vào CMS. Đổi thành chuỗi khó đoán khi chạy thật, ví dụ /cms-9f2a1c
CMS_PATH=/cms

# Khóa ký phiên đăng nhập.
# Để trống -> server tự sinh khóa ngẫu nhiên và lưu vào server/data/.jwt-secret
# Chỉ cần đặt tay khi chạy nhiều tiến trình (PM2 cluster) hoặc nhiều máy chủ.
JWT_SECRET=
JWT_EXPIRES_IN=2d

# Tài khoản CMS nằm trong tệp server/data/credentials.json.
# Hai biến dưới CHỈ dùng khi tệp đó chưa tồn tại (lần chạy đầu tiên).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Chống dò mật khẩu
MAX_LOGIN_ATTEMPTS=6
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Giới hạn dung lượng mỗi tệp tải lên (MB)
UPLOAD_MAX_MB=15

# Tên miền được phép gọi API ghi dữ liệu, cách nhau bằng dấu phẩy.
# Để trống là đủ cho hầu hết trường hợp (server tự tin tưởng chính host của nó).
TRUSTED_ORIGINS=

# Số tầng proxy đứng trước ứng dụng.
# Để trống/false khi chạy trực tiếp (an toàn nhất).
# Đặt 1 khi chạy sau Nginx — nếu bật sai, kẻ tấn công giả mạo được IP
# và vượt qua giới hạn số lần đăng nhập.
TRUST_PROXY=

# Thư mục lưu dữ liệu (db.json, credentials.json, khóa phiên).
# Để trống = server/data. Đổi khi muốn tách dữ liệu ra ổ/thư mục khác.
DATA_DIR=

# Tuổi thọ phiên đăng nhập CMS.
# Bình thường: cookie mất khi đóng trình duyệt.
# Khi người dùng tick "Ghi nhớ tôi": giữ phiên trong REMEMBER_DAYS ngày.
JWT_REMEMBER_EXPIRES_IN=30d
REMEMBER_DAYS=30

# Phiên "Ghi nhớ tôi" tự gia hạn khi đã đi quá nửa đời, nên còn dùng CMS đều đặn
# thì không bao giờ phải đăng nhập lại. Bỏ hẳn REMEMBER_DAYS ngày thì mới hết hạn.
